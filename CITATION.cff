      - family-names: Michel
        given-names: Élie
      - family-names: Lambert
        given-names: Thibaud
      - family-names: Boubekeur
        given-names: Tamy
      - family-names: Paulin
        given-names: Mathias
      - family-names: Thonat
        given-names: Théo
    journal: "Computer Graphics Forum"
    volume: 44
    issue: 2
    start: e70057
    year: 2025
    doi: 10.1111/cgf.70057
