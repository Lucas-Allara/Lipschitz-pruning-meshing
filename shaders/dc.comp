// Dual contouring of the finest octree level on the GPU, the same algorithm as
// dual_contour_leaves in include/lpm/dc.h. The hash maps of the CPU code become dense grids:
// cell_grid (one entry per cell of the N^3 grid), corner_val ((N + 1)^3 corners) and bitsets of
// the leaves and of the crossing edges, whose prefix sums give the rank of a leaf or an edge.
// Compacting the bitsets lists the leaves and the edges in increasing key order, the order the
// CPU code obtains by sorting, so the output does not depend on the scheduling of the GPU.
// A dynamic frame (frame = 1) touches a small region of the grid: its bitsets carry a second
// level, one bit per word, and atomic counts, so that compacting visits only the words in use,
// and the next frame clears only what this one set (STAGE_CLEAR).
// Every stage is one dispatch; this file is compiled once per stage with -DSTAGE=n.
#version 460
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_EXT_shader_atomic_int64 : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require
#extension GL_KHR_shader_subgroup_ballot : require

#define STAGE_SCATTER 1   // leaves into the cell grid and the leaf bitset
#define STAGE_COMPACT 2   // bitset to the sorted list of its set positions
#define STAGE_CORNERS 3   // value of every corner of a leaf
#define STAGE_EDGES 4     // bitset of the sign-changing edges of the leaves
#define STAGE_CROSS 5     // crossing point and normal of every such edge
#define STAGE_COMP 6      // connected components of the crossing edges of every leaf
#define STAGE_QEF 7       // one vertex per component
#define STAGE_FACES 8     // two triangles per crossing edge
// Patch of a dynamic frame (dynamic.h), with frame = 1:
#define STAGE_TOUCH 9     // static leaves under the culled cells, one workgroup per culled cell
#define STAGE_DYNBITS 10  // the dynamic leaves into the bitsets
#define STAGE_RING 11     // static leaves sharing a corner with a dynamic leaf
#define STAGE_REGION 12   // the region cells (dynamic leaves, ring, and with coarse leaves the finest leaves of
                          // each dissolved coarse leaf and one cell around it) in increasing cell order
#define STAGE_KEEP 13     // static faces that no dynamic or swallowed cell (nor a dissolved coarse leaf) touches;
                          // marching cubes: the static leaves whose triangles stay
#define STAGE_NEWFLAGS 14 // faces of the region that stay
#define STAGE_ASSEMBLE 15 // kept static faces (triangles with marching cubes), then the new ones
#define STAGE_CLEAR 16    // what the previous frame set in the grids and bitsets
#define STAGE_LIST 17     // the words in use of a bitset, from its second level, in increasing order
// Coarse leaves of probe.comp, with coarse_on:
#define STAGE_COARSE_VERT 18   // the vertex of every coarse leaf
#define STAGE_COARSE_FACES 19  // the faces of the edges of the coarse leaves that no smaller leaf touches
// Marching cubes on the leaves, with mc = 1, instead of QEF and FACES (COMP writes the pairings and counts):
#define STAGE_MC_FACES 20      // the triangles of every leaf, around the cycles of its crossing edges
// Frames of a dynamic scene with coarse leaves:
#define STAGE_DISSOLVE 21      // the finest leaves of every coarse leaf that the frame dissolves, into the region

layout(local_size_x = 64) in;
layout(constant_id = 0) const int STACK = 16;

layout(buffer_reference, std430, buffer_reference_align = 4) buffer U32 { uint v[]; };
layout(buffer_reference, std430, buffer_reference_align = 8) buffer F64 { double v[]; };
layout(buffer_reference, std430, buffer_reference_align = 8) buffer Counters {
    uint64_t prim_evals, op_evals;
    uint ambiguous, empty_triangles;
};

layout(buffer_reference, std430, buffer_reference_align = 32) readonly buffer Params {
    dvec4 aabb_min;
    dvec4 size;       // size of a leaf cell
    double fd_h;      // finite difference step of the normals
    uint N;           // cells per axis
    uint n_cells;     // leaves of the octree
    uint max_iters;   // root finding iterations
    uint full_n;      // > 0: evaluate the full tree, entries [0, full_n) of tree_pool, everywhere
    U32 nodes;        // 2 per node: type, index of its primitive or operator
    F64 prims;        // 24 per primitive
    F64 ops;          // 4 per operator: k, s, 0.25 / k
    U32 leaf_cells;   // 8 per leaf of the octree: x, y, z, -, tree offset, tree size, -, -
    U32 tree_pool;    // 3 per tree entry, as TreeEntry
    U32 cell_grid;    // N^3: index of the leaf in leaf_cells + 1, or 0 (not used by a frame, see cell_at)
    U32 cell_bits;    // N^3 bits: the cell is a leaf
    U32 cell_prefix;  // per word of cell_bits: leaves before it
    U32 leaves;       // leaves in increasing cell order (index in leaf_cells)
    F64 corner_val;   // (N + 1)^3
    U32 edge_bits;    // 3 (N + 1)^3 bits, edge key = corner key * 3 + axis
    U32 edge_prefix;  // per word of edge_bits: crossing edges before it
    U32 edges;        // crossing edge keys in increasing order
    F64 crossings;    // 6 per crossing edge: point, unit normal
    U32 comp;         // 2 per sorted leaf: component of each of its 12 edges, 4 bits each (15: none)
    U32 ncomp;        // components per sorted leaf
    U32 vbase;        // first vertex of each sorted leaf
    F64 V;            // 3 per vertex
    U32 F;            // 6 per crossing edge: two triangles, one (F[6u + 3] = 0xffffffff, next to a
                      // coarse leaf) or none (F[6u] = 0xffffffff)
    U32 vtree;        // tree size of the cell of each vertex
    Counters counters;
    // Patch of a dynamic frame. The leaves are the region cells; leaf_cells[8 i + 3] = 1 marks a
    // static ring cell, whose tree is in static_pool and whose corners, crossings and vertices are
    // those of the static mesh. The static_* arrays are the dual contouring of the static scene.
    uint frame;
    uint nv_static;       // vertices of the static mesh; the new vertices follow them
    uint depth;
    uint n_static_edges;  // static face slots: Es finest crossing edges, then 12 per coarse leaf; static leaves (mc)
    U32 static_pool;
    F64 static_corner_val;
    U32 static_edge_bits;
    U32 static_edge_prefix;
    F64 static_crossings;
    U32 static_cell_bits;
    U32 static_cell_prefix;
    U32 static_vbase;
    U32 static_leaf_cells;
    U32 static_edges;
    U32 static_F;
    U32 dyn_cells;        // dynamic leaves, 8 uints each
    U32 dyn_bits;         // N^3 bits
    U32 touched_bits;     // N^3 bits: static leaves swallowed by the sphere
    U32 culled;           // culled cells with static surface below: x, y, z, level
    U32 ncomp_dyn;        // components of each region cell that is dynamic, 0 for the ring
    U32 vbase_dyn;        // first new vertex of each region cell
    U32 keep_static;      // per static face slot, 1 when its face stays; mc: per static leaf, its kept triangles
    U32 keep_prefix;
    U32 new_flags;        // per region crossing edge: 1 when it gives a new quad
    U32 new_prefix;
    U32 out_F;            // kept static faces, then new ones: 6 indices per slot (the second triangle NONE
                          // where a face next to a coarse leaf is one), or 3 per triangle with mc
    U32 patch_args;       // shaders/dyn_args.comp, mode 1: v[6] dynamic leaves, v[7] swallowed cells
    // Frame: second level of the bitsets and the words in use. frame_counts: region cells and
    // their words, crossing edges and their words.
    U32 frame_counts;
    U32 cell_hi;          // one bit per word of cell_bits
    U32 cell_hi_prefix;
    U32 cell_word_list;   // words of cell_bits in use, in increasing order
    U32 cell_word_count;  // their set bits
    U32 cell_word_prefix;
    U32 edge_hi;
    U32 edge_hi_prefix;
    U32 edge_word_list;
    U32 edge_word_count;
    U32 edge_word_prefix;
    // Coarse leaves (probe.comp): their bitsets, one per level, concatenated (level l from word
    // coarse_word_off[l]), and the prefix sums of the words, whose ranks number the coarse leaves
    // by level and then by cell. The coarse leaf of rank r has the vertex nv_fine + r.
    U32 coarse_bits;
    U32 coarse_prefix;
    U32 coarse_records;   // 12 uints per coarse leaf, as probe.comp writes them, all levels
    U32 coarse_F;         // 6 per edge of each coarse leaf (by rank): as F
    uint coarse_on;
    uint coarse_min;      // first level with coarse leaves
    uint nv_fine;         // vertices of the finest leaves
    uint n_coarse;
    uint coarse_word_off[12];
    U32 corner_list;      // frame: the corners to evaluate (STAGE_CORNERS mode 1), counted in frame_counts.v[4]
    U32 static_leaves;    // frame: the static leaves in increasing cell order (leaves of the static run)
    // Marching cubes on the leaves (not with coarse leaves): the vertices are the crossing points (V
    // and vtree by crossing edge), COMP writes the triangles of each leaf to ncomp (and ncomp_dyn) and
    // the pairings of its ambiguous faces to comp, and MC_FACES writes the triangles from vbase on. A
    // frame keeps the static triangles leaf by leaf (KEEP, ASSEMBLE) and writes those of its new cells
    // after them in out_F, from keep_prefix[n_static_edges] + vbase_dyn.
    uint mc;
    uint project;  // 1: the vertices of QEF onto the surface (DCParams::project_vertices; 0 with the coarse leaves of mesh())
    // Frame of a dynamic scene with coarse leaves (coarse_on): per coarse leaf, by rank, 1 when a
    // dynamic or swallowed cell lies in it; the frame meshes it by its finest leaves.
    U32 dissolved;
};

layout(push_constant) uniform PC {
    Params p;
    uint count;  // invocations that do work
    uint mode;   // STAGE_COMPACT: 0 leaves, 1 edges
} pc;

#define P (pc.p)
#define PRIM_VALUE(i) P.prims.v[i]
#include "sdf.glsl"

const uint NODE_PRIM = 1u;
const uint NONE = 0xffffffffu;
const int edge_corners[12][2] = {{0, 1}, {2, 3}, {4, 5}, {6, 7}, {0, 2}, {1, 3}, {4, 6}, {5, 7}, {0, 4}, {1, 5}, {2, 6}, {3, 7}};

uint prim_evals = 0u, op_evals = 0u;

// The tree of a leaf (offset, size, 1 when it is in static_pool), or the full tree.
uvec3 leaf_tree(uint id) {
    if (P.full_n > 0u) return uvec3(0u, P.full_n, 0u);
    return uvec3(P.leaf_cells.v[8u * id + 4u], P.leaf_cells.v[8u * id + 5u], P.leaf_cells.v[8u * id + 3u]);
}
bool is_static(uint id) { return P.frame != 0u && P.leaf_cells.v[8u * id + 3u] != 0u; }

uint pool_value(uvec3 tree, uint i) { return tree.z != 0u ? P.static_pool.v[i] : P.tree_pool.v[i]; }

double eval_tree(uvec3 tree, dvec3 p) {
    double st[STACK];
    int sp = 0;
    for (uint i = 0u; i < tree.y; i++) {
        const uint e = 3u * (tree.x + i);
        const uint node = pool_value(tree, e);
        const uint type = P.nodes.v[2u * node], idx = P.nodes.v[2u * node + 1u];
        double d;
        if (type == NODE_PRIM) {
            d = eval_primitive(idx, p);
            prim_evals++;
        } else {
            sp--; const double b = st[sp];
            sp--; const double a = st[sp];
            const dvec4 op = dvec4(P.ops.v[4u * idx], P.ops.v[4u * idx + 1u], P.ops.v[4u * idx + 2u], 0.0);
            d = eval_op(op, a, b);
            op_evals++;
        }
        st[sp] = (pool_value(tree, e + 2u) & 0xffu) == 0xffu ? -d : d;
        sp++;
    }
    return st[0];
}

#include "dc_common.glsl"

// Adds the evaluations of the invocation to the counters, one atomic per subgroup; every
// invocation calls it once, in uniform control flow.
void flush_counters() {
    const uint sp = subgroupAdd(prim_evals), so = subgroupAdd(op_evals);
    if (subgroupElect() && (sp | so) != 0u) {
        atomicAdd(P.counters.prim_evals, uint64_t(sp));
        atomicAdd(P.counters.op_evals, uint64_t(so));
    }
}

uint lin(uvec3 c) { return (c.x * P.N + c.y) * P.N + c.z; }
// Rank of the leaf at linear position l among the sorted leaves (the bit must be set).
uint leaf_rank(uint l) {
    return P.cell_prefix.v[l >> 5] + bitCount(P.cell_bits.v[l >> 5] & ((1u << (l & 31u)) - 1u));
}
uint edge_rank(uint k) {
    return P.edge_prefix.v[k >> 5] + bitCount(P.edge_bits.v[k >> 5] & ((1u << (k & 31u)) - 1u));
}
uint static_edge_rank(uint k) {
    return P.static_edge_prefix.v[k >> 5] + bitCount(P.static_edge_bits.v[k >> 5] & ((1u << (k & 31u)) - 1u));
}
uint static_leaf_rank(uint l) {
    return P.static_cell_prefix.v[l >> 5] + bitCount(P.static_cell_bits.v[l >> 5] & ((1u << (l & 31u)) - 1u));
}
#define BIT(bits, l) (((bits).v[(l) >> 5] & (1u << ((l) & 31u))) != 0u)
// Whether the cell at integer coordinates is a leaf, from the bitset: 32 times less memory than
// cell_grid (512 MB at depth 9, where its scattered reads miss the caches).
bool is_leaf(ivec3 c) {
    if (any(lessThan(c, ivec3(0))) || any(greaterThanEqual(c, ivec3(int(P.N))))) return false;
    return BIT(P.cell_bits, lin(uvec3(c)));
}
// Index in leaf_cells of the leaf at integer cell coordinates, or -1. A frame lists its region
// cells in increasing cell order, so the index is the rank in the region bitset and the dense
// cell_grid (512 MB at depth 9) is not needed.
int cell_at(ivec3 c) {
    if (any(lessThan(c, ivec3(0))) || any(greaterThanEqual(c, ivec3(int(P.N))))) return -1;
    const uint l = lin(uvec3(c));
    if (P.frame != 0u) return BIT(P.cell_bits, l) ? int(leaf_rank(l)) : -1;
    return int(P.cell_grid.v[l]) - 1;
}

// Frame: sets the region bit of cell l, counting the new cells and the new words in frame_counts
// (0 and 1) and marking the word in the second level.
void set_region_bit(uint l) {
    const uint bit = 1u << (l & 31u);
    const uint old = atomicOr(P.cell_bits.v[l >> 5], bit);
    if ((old & bit) != 0u) return;
    atomicAdd(P.frame_counts.v[0], 1u);
    if (old == 0u) {
        atomicAdd(P.frame_counts.v[1], 1u);
        atomicOr(P.cell_hi.v[l >> 10], 1u << ((l >> 5) & 31u));
    }
}
// The same for the cells of mask m in word w of the region bitset.
void set_region_bits(uint w, uint m) {
    const uint old = atomicOr(P.cell_bits.v[w], m), fresh = m & ~old;
    if (fresh == 0u) return;
    atomicAdd(P.frame_counts.v[0], bitCount(fresh));
    if (old == 0u) {
        atomicAdd(P.frame_counts.v[1], 1u);
        atomicOr(P.cell_hi.v[w >> 5], 1u << (w & 31u));
    }
}
uint corner_key(uvec3 c) { const uint n1 = P.N + 1u; return (c.x * n1 + c.y) * n1 + c.z; }
uvec3 corner_of_key(uint key) { const uint n1 = P.N + 1u; return uvec3(key / (n1 * n1), (key / n1) % n1, key % n1); }
dvec3 corner_point(uvec3 c) { return P.aabb_min.xyz + dvec3(c) * P.size.xyz; }
uvec3 leaf_xyz(uint id) { return uvec3(P.leaf_cells.v[8u * id], P.leaf_cells.v[8u * id + 1u], P.leaf_cells.v[8u * id + 2u]); }
uint tree_size(uint id) { return P.leaf_cells.v[8u * id + 5u]; }

// The four cells around the edge from corner c along axis, counterclockwise around the +axis
// direction (edge_cells).
void cells_around(ivec3 c, uint axis, out ivec3 cs[4]) {
    const ivec2 off[4] = {ivec2(-1, -1), ivec2(0, -1), ivec2(0, 0), ivec2(-1, 0)};
    for (int q = 0; q < 4; q++) {
        ivec3 x = c;
        if (axis == 0u) { x.y += off[q].x; x.z += off[q].y; }
        else if (axis == 1u) { x.z += off[q].x; x.x += off[q].y; }
        else { x.x += off[q].x; x.y += off[q].y; }
        cs[q] = x;
    }
}
void edge_cells(uint ekey, out int ids[4]) {
    ivec3 cs[4];
    cells_around(ivec3(corner_of_key(ekey / 3u)), ekey % 3u, cs);
    for (int q = 0; q < 4; q++) ids[q] = cell_at(cs[q]);
}

// Rank of the coarse leaf at cell c of level l, or -1 when that cell is not a coarse leaf.
int coarse_rank(uint l, uvec3 c) {
    const uint side = 1u << l, lin = (c.x * side + c.y) * side + c.z;
    const uint w = P.coarse_word_off[l] + (lin >> 5), bit = 1u << (lin & 31u), word = P.coarse_bits.v[w];
    if ((word & bit) == 0u) return -1;
    return int(P.coarse_prefix.v[w] + bitCount(word & (bit - 1u)));
}
// The coarse leaf that contains cell c of level l (the cell itself or an ancestor): its rank, and
// its level in lvl; -1 when there is none.
int coarse_cover(uint l, ivec3 c, out uint lvl) {
    lvl = 0u;
    if (any(lessThan(c, ivec3(0))) || any(greaterThanEqual(c, ivec3(int(1u << l))))) return -1;
    for (int k = min(int(l), int(P.depth) - 1); k >= int(P.coarse_min); k--) {
        const int r = coarse_rank(uint(k), uvec3(c) >> (l - uint(k)));
        if (r >= 0) { lvl = uint(k); return r; }
    }
    return -1;
}
// The face of an edge whose four cells (counterclockwise) have the vertices v, as process_edge in
// include/lpm/adaptive.h: a coarse leaf covering two of the cells repeats its vertex, which leaves
// a triangle (out_f[o + 3] = NONE); two distinct vertices leave nothing.
void emit_face(uint64_t faces, uint o, uint v[4], bool outside) {
    U32 out_f = U32(faces);
    uint w[4];
    int m = 0;
    for (int k = 0; k < 4; k++) if (m == 0 || w[m - 1] != v[k]) w[m++] = v[k];
    if (m == 4 && w[3] == w[0]) m = 3;
    if (m < 3) { out_f.v[o] = NONE; return; }
    if (m == 3) {
        if (outside) { const uint t = w[1]; w[1] = w[2]; w[2] = t; }
        out_f.v[o] = w[0]; out_f.v[o + 1u] = w[1]; out_f.v[o + 2u] = w[2]; out_f.v[o + 3u] = NONE;
        return;
    }
    if (outside) { const uint t = v[1]; v[1] = v[3]; v[3] = t; }
    out_f.v[o] = v[0]; out_f.v[o + 1u] = v[1]; out_f.v[o + 2u] = v[2];
    out_f.v[o + 3u] = v[0]; out_f.v[o + 4u] = v[2]; out_f.v[o + 5u] = v[3];
}

#if STAGE == STAGE_SCATTER
void main() {
    const uint i = gl_GlobalInvocationID.x;
    if (i >= pc.count) return;
    const uint l = lin(leaf_xyz(i));
    P.cell_grid.v[l] = i + 1u;
    atomicOr(P.cell_bits.v[l >> 5], 1u << (l & 31u));  // not dispatched by a frame
}

#elif STAGE == STAGE_COMPACT
void main() {
    uint w = gl_GlobalInvocationID.x;
    if (w >= pc.count) return;
    const bool edges = pc.mode == 1u;
    uint out_i;
    if (P.frame != 0u) {
        // A frame: one invocation per word in use, whose prefix is written here for edge_rank.
        const uint j = w;
        w = edges ? P.edge_word_list.v[j] : P.cell_word_list.v[j];
        out_i = edges ? P.edge_word_prefix.v[j] : P.cell_word_prefix.v[j];
        if (edges) P.edge_prefix.v[w] = out_i;
    } else out_i = edges ? P.edge_prefix.v[w] : P.cell_prefix.v[w];
    uint bits = edges ? P.edge_bits.v[w] : P.cell_bits.v[w];
    while (bits != 0u) {
        const uint b = findLSB(bits);
        bits &= bits - 1u;
        const uint pos = 32u * w + b;
        if (edges) P.edges.v[out_i] = pos;
        else P.leaves.v[out_i] = P.frame != 0u ? out_i : P.cell_grid.v[pos] - 1u;  // a frame lists in cell order
        out_i++;
    }
}

#elif STAGE == STAGE_CORNERS
// The value of a corner, from the adjacent leaf with the smallest tree (as corner_owner).
void corner_value(uint key) {
    const ivec3 c = ivec3(corner_of_key(key));
    int best = -1;
    bool any_static = false;
    for (int k = 0; k < 8; k++) {
        const ivec3 x = c - ivec3(k & 1, (k >> 1) & 1, (k >> 2) & 1);
        if (!is_leaf(x)) continue;
        const int id = cell_at(x);
        any_static = any_static || is_static(uint(id));
        if (best < 0 || tree_size(uint(id)) < tree_size(uint(best))) best = id;
    }
    // A corner of a static cell keeps its static value: the field there is that of T.
    if (best >= 0 && any_static) P.corner_val.v[key] = P.static_corner_val.v[key];
    else if (best >= 0) P.corner_val.v[key] = eval_tree(leaf_tree(uint(best)), corner_point(uvec3(c)));
}

// mode 0: one invocation per corner of the grid. mode 1: one per corner of each leaf; the first of
// the leaves around a corner lists it. mode 2: one per listed corner (the list is contiguous, so
// that every subgroup evaluates full: in mode 1 only one invocation in five or so owns its corner).
void main() {
    const uint t = gl_GlobalInvocationID.x;
    if (pc.mode == 0u) {
        if (t < pc.count) corner_value(t);
    } else if (pc.mode == 1u) {
        bool own = false;
        uint key = 0u;
        if (t < pc.count) {
            const uint i = t >> 3, k = t & 7u;
            const ivec3 c = ivec3(leaf_xyz(i) + uvec3(k & 1u, (k >> 1) & 1u, (k >> 2) & 1u));
            int first = -1;
            for (int j = 0; j < 8 && first < 0; j++) if (is_leaf(c - ivec3(j & 1, (j >> 1) & 1, (j >> 2) & 1))) first = j;
            own = c - ivec3(first & 1, (first >> 1) & 1, (first >> 2) & 1) == ivec3(leaf_xyz(i));
            key = corner_key(uvec3(c));
        }
        const uint before = subgroupExclusiveAdd(own ? 1u : 0u), total = subgroupAdd(own ? 1u : 0u);
        uint base = 0u;
        if (subgroupElect() && total > 0u) base = atomicAdd(P.frame_counts.v[4], total);
        base = subgroupBroadcastFirst(base);
        if (own) P.corner_list.v[base + before] = key;
    } else if (t < P.frame_counts.v[4]) {
        corner_value(P.corner_list.v[t]);
    }
    flush_counters();
}

#elif STAGE == STAGE_EDGES
// mode 0: one invocation per edge of the grid; mode 1: one per edge of each leaf, the edge being
// done by the first of its four cells that is a leaf.
void main() {
    uint ekey = gl_GlobalInvocationID.x;
    if (ekey >= pc.count) return;
    if (pc.mode == 1u) {
        const uint i = ekey / 12u, e = ekey % 12u;
        const int c0 = edge_corners[e][0];
        const uvec3 corner = leaf_xyz(i) + uvec3(c0 & 1, (c0 >> 1) & 1, (c0 >> 2) & 1);
        ekey = corner_key(corner) * 3u + e / 4u;
        int ids[4];
        edge_cells(ekey, ids);
        int first = -1;
        for (int q = 0; q < 4 && first < 0; q++) first = ids[q];
        if (first != int(i)) return;
    }
    const uint axis = ekey % 3u, key = ekey / 3u;
    const uvec3 c = corner_of_key(key);
    if (c[axis] >= P.N) return;
    int ids[4];
    edge_cells(ekey, ids);
    if (ids[0] < 0 && ids[1] < 0 && ids[2] < 0 && ids[3] < 0) return;  // not an edge of a leaf
    uvec3 c1 = c;
    c1[axis] += 1u;
    if ((P.corner_val.v[key] < 0.0) != (P.corner_val.v[corner_key(c1)] < 0.0)) {
