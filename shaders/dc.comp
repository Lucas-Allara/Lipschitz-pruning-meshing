// mode 1: the static mesh of a dynamic scene with coarse leaves, whose static octree has its finest
// leaves also inside the coarse leaves. There, and in its frames, a cell inside a coarse leaf gives
// the vertex of the coarse leaf (unless the frame dissolves it), and an edge with no finest leaf
// around it is left to COARSE_FACES.
void main() {
    const uint u = gl_GlobalInvocationID.x;
    if (u >= pc.count) return;
    const uint ekey = P.edges.v[u];
    const uint axis = ekey % 3u, key = ekey / 3u;
    const uvec3 corner = corner_of_key(key);
    ivec3 cs[4];
    cells_around(ivec3(corner), axis, cs);
    const bool coarse_first = P.coarse_on != 0u && (pc.mode == 1u || P.frame != 0u);
    uint v[4];
    bool any_changed = false, any_coarse = false, any_fine = false;
    for (int q = 0; q < 4; q++) {
        bool dissolved = false;
        if (coarse_first) {
            uint lvl;
            const int r = coarse_cover(P.depth, cs[q], lvl);
            if (r >= 0) {
                if (P.frame == 0u || P.dissolved.v[uint(r)] == 0u) {
                    v[q] = P.nv_fine + uint(r);
                    any_coarse = true;
                    continue;
                }
                dissolved = true;
            }
        }
        const int id = cell_at(cs[q]);
        if (id < 0) {
            // A cell inside a coarse leaf gives the vertex of the coarse leaf (mesh()).
            uint lvl;
            const int r = P.coarse_on != 0u && !coarse_first ? coarse_cover(P.depth, cs[q], lvl) : -1;
            if (r < 0) { P.F.v[6u * u] = NONE; return; }
            v[q] = P.nv_fine + uint(r);
            any_coarse = true;
            continue;
        }
        any_fine = true;
        const uvec3 xyz = leaf_xyz(uint(id));
        const uint rank = leaf_rank(lin(xyz));
        const bool st = is_static(uint(id));
        any_changed = any_changed || !st || dissolved;
        const ivec3 bits = ivec3(corner) - ivec3(xyz);
        const int b = axis == 0u ? 1 : 0, c = axis == 2u ? 1 : 2;
        const int le = 4 * int(axis) + bits[b] + 2 * bits[c];
        const uint w = le < 8 ? P.comp.v[2u * rank] : P.comp.v[2u * rank + 1u];
        const uint cq = (w >> (4 * (le < 8 ? le : le - 8))) & 15u;
        if (cq == 15u) { P.F.v[6u * u] = NONE; return; }
        if (P.frame == 0u) v[q] = P.vbase.v[rank] + cq;
        else if (st) v[q] = P.static_vbase.v[static_leaf_rank(lin(xyz))] + cq;  // the static vertex
        else v[q] = P.nv_static + P.vbase_dyn.v[rank] + cq;
