        if (r >= 0) P.dissolved.v[uint(r)] = 1u;  // its coarse leaf is meshed by its finest leaves
    } else {
        const uint r = leaf_rank(l);
        for (uint k = 0u; k < 8u; k++) P.leaf_cells.v[8u * r + k] = P.dyn_cells.v[8u * i + k];
        P.leaf_cells.v[8u * r + 3u] = 0u;
    }
}

#elif STAGE == STAGE_RING
// Static leaves sharing a corner with a dynamic leaf, unless dynamic or swallowed, join the region.
void main() {
    const uint i = gl_GlobalInvocationID.x;
    if (i >= P.patch_args.v[6]) return;
    const ivec3 c = ivec3(P.dyn_cells.v[8u * i], P.dyn_cells.v[8u * i + 1u], P.dyn_cells.v[8u * i + 2u]);
    for (int d = 0; d < 27; d++) {
        if (d == 13) continue;
        const ivec3 x = c + ivec3(d / 9 - 1, (d / 3) % 3 - 1, d % 3 - 1);
        if (any(lessThan(x, ivec3(0))) || any(greaterThanEqual(x, ivec3(int(P.N))))) continue;
        const uint l = lin(uvec3(x));
        if (!BIT(P.static_cell_bits, l) || BIT(P.dyn_bits, l) || BIT(P.touched_bits, l)) continue;
        set_region_bit(l);
    }
}

#elif STAGE == STAGE_REGION
// The region cells in increasing cell order, one invocation per word of cell_bits in use (whose
// prefix, written here, serves leaf_rank): the static ring cells (flag 1) with their static
// trees; the dynamic leaves go to their places in STAGE_DYNBITS mode 1.
void main() {
    const uint j = gl_GlobalInvocationID.x;
    if (j >= pc.count) return;
    const uint w = P.cell_word_list.v[j];
    uint bits = P.cell_bits.v[w];
    uint out_i = P.cell_word_prefix.v[j];
    P.cell_prefix.v[w] = out_i;
    while (bits != 0u) {
        const uint b = findLSB(bits);
        bits &= bits - 1u;
        const uint l = 32u * w + b;
        if (!BIT(P.dyn_bits, l)) {
            const uint id = P.static_leaves.v[static_leaf_rank(l)];
            for (uint k = 0u; k < 8u; k++) P.leaf_cells.v[8u * out_i + k] = P.static_leaf_cells.v[8u * id + k];
            P.leaf_cells.v[8u * out_i + 3u] = 1u;
        }
        out_i++;
    }
}

#elif STAGE == STAGE_KEEP
void main() {
    const uint u = gl_GlobalInvocationID.x;
    if (u >= pc.count) return;
    if (P.mc != 0u) {
        // Marching cubes: the triangles of static leaf u stay unless the leaf is dynamic or swallowed.
        const uint id = P.static_leaves.v[u];
        const uint l = lin(uvec3(P.static_leaf_cells.v[8u * id], P.static_leaf_cells.v[8u * id + 1u], P.static_leaf_cells.v[8u * id + 2u]));
        const bool gone = BIT(P.dyn_bits, l) || BIT(P.touched_bits, l);
        P.keep_static.v[u] = gone ? 0u : P.static_vbase.v[u + 1u] - P.static_vbase.v[u];
        return;
    }
    // With coarse leaves the static faces are those of the finest edges (es of them), then those of
    // the edges of the coarse leaves (12 per leaf, by rank), which invocation es + 12 k + e handles
    // for the record k: such a face stays unless a coarse leaf around its edge is dissolved.
    const uint es = P.n_static_edges - (P.coarse_on != 0u ? 12u * P.n_coarse : 0u);
    if (u >= es) {
        const uint k = (u - es) / 12u, e = (u - es) % 12u;
        const uvec3 xyz = uvec3(P.coarse_records.v[12u * k], P.coarse_records.v[12u * k + 1u], P.coarse_records.v[12u * k + 2u]);
        const uint level = P.coarse_records.v[12u * k + 3u] & 0xffu;
        const uint slot = es + 12u * uint(coarse_rank(level, xyz)) + e;
        uint kc = 0u;
        if (P.static_F.v[6u * slot] != NONE) {
            kc = 1u;
            const int c0 = edge_corners[e][0];
            ivec3 cs[4];
            cells_around(ivec3(xyz) + ivec3(c0 & 1, (c0 >> 1) & 1, (c0 >> 2) & 1), uint(e / 4u), cs);
            for (int q = 0; q < 4; q++) {
                uint lvl;
                const int r = coarse_cover(level, cs[q], lvl);
                if (r >= 0 && P.dissolved.v[uint(r)] != 0u) kc = 0u;
            }
        }
        P.keep_static.v[slot] = kc;
        return;
    }
    uint keep = 0u;
    if (P.static_F.v[6u * u] != NONE) {
        keep = 1u;
        const uint ekey = P.static_edges.v[u];
        const uint axis = ekey % 3u;
        const ivec3 c = ivec3(corner_of_key(ekey / 3u));
        const ivec2 off[4] = {ivec2(-1, -1), ivec2(0, -1), ivec2(0, 0), ivec2(-1, 0)};
        for (int q = 0; q < 4; q++) {
            ivec3 x = c;
            if (axis == 0u) { x.y += off[q].x; x.z += off[q].y; }
            else if (axis == 1u) { x.z += off[q].x; x.x += off[q].y; }
            else { x.x += off[q].x; x.y += off[q].y; }
            const uint l = lin(uvec3(x));  // the four cells of a static quad are leaves, so inside the grid
            if (BIT(P.dyn_bits, l) || BIT(P.touched_bits, l)) keep = 0u;
            uint lvl;
            const int r = P.coarse_on != 0u ? coarse_cover(P.depth, x, lvl) : -1;
            if (r >= 0 && P.dissolved.v[uint(r)] != 0u) keep = 0u;
        }
    }
    P.keep_static.v[u] = keep;
}

#elif STAGE == STAGE_NEWFLAGS
void main() {
    const uint u = gl_GlobalInvocationID.x;
    if (u >= pc.count) return;
    P.new_flags.v[u] = P.F.v[6u * u] != NONE ? 1u : 0u;
}

#elif STAGE == STAGE_ASSEMBLE
// mode 0: the kept static quads; mode 1: the new quads after them.
void main() {
    const uint u = gl_GlobalInvocationID.x;
    if (u >= pc.count) return;
    if (P.mc != 0u) {
        // Marching cubes: the triangles of the kept static leaf u (MC_FACES wrote the new ones after them).
        const uint n = 3u * P.keep_static.v[u], src = 3u * P.static_vbase.v[u], dst = 3u * P.keep_prefix.v[u];
        for (uint k = 0u; k < n; k++) P.out_F.v[dst + k] = P.static_F.v[src + k];
        return;
    }
    // Next to a coarse leaf a face may be one triangle, and the other of its slot is NONE: the
    // vertex shader of the viewer drops it, and empty_triangles counts it.
    uint empty = 0u;
    if (pc.mode == 0u) {
        if (P.keep_static.v[u] == 0u) return;
        const uint o = 6u * P.keep_prefix.v[u];
        for (uint k = 0u; k < 6u; k++) P.out_F.v[o + k] = P.static_F.v[6u * u + k];
        for (uint t = 0u; t < 6u; t += 3u) empty += P.static_F.v[6u * u + t] == NONE || P.static_F.v[6u * u + t + 1u] == NONE || P.static_F.v[6u * u + t + 2u] == NONE ? 1u : 0u;
    } else {
        if (P.new_flags.v[u] == 0u) return;
        const uint o = 6u * (P.keep_prefix.v[P.n_static_edges] + P.new_prefix.v[u]);
        for (uint k = 0u; k < 6u; k++) P.out_F.v[o + k] = P.F.v[6u * u + k];
        for (uint t = 0u; t < 6u; t += 3u) empty += P.F.v[6u * u + t] == NONE || P.F.v[6u * u + t + 1u] == NONE || P.F.v[6u * u + t + 2u] == NONE ? 1u : 0u;
    }
    const uint e = subgroupAdd(empty);
    if (subgroupElect() && e > 0u) atomicAdd(P.counters.empty_triangles, e);
}
#elif STAGE == STAGE_CLEAR
// The start of a frame: zero what the previous one set, from its lists. mode 0: one invocation per
// region cell (cell grid, region, dynamic and second-level bits); mode 1: one per crossing edge;
// mode 2: one workgroup per swallowed cell (its static leaves in touched_bits, as TOUCH).
void main() {
    if (pc.mode == 2u) {
        const uint k = gl_WorkGroupID.x;
        if (k >= pc.count) return;
        const uvec3 c = uvec3(P.culled.v[4u * k], P.culled.v[4u * k + 1u], P.culled.v[4u * k + 2u]);
        const uint side = 1u << (P.depth - P.culled.v[4u * k + 3u]);
        const uvec3 base = c * side;
        const uint total = side * side * side;
        for (uint t = gl_LocalInvocationID.x; t < total; t += gl_WorkGroupSize.x)
            P.touched_bits.v[lin(base + uvec3(t / (side * side), (t / side) % side, t % side)) >> 5] = 0u;
        return;
    }
    const uint i = gl_GlobalInvocationID.x;
    if (i >= pc.count) return;
    if (pc.mode == 0u) {
        const uint l = lin(leaf_xyz(i));
        P.cell_bits.v[l >> 5] = 0u;
        P.dyn_bits.v[l >> 5] = 0u;
        P.cell_hi.v[l >> 10] = 0u;
    } else {
        const uint k = P.edges.v[i];
        P.edge_bits.v[k >> 5] = 0u;
        P.edge_hi.v[k >> 10] = 0u;
    }
}

#elif STAGE == STAGE_LIST
// One invocation per word of the second level (prefix sums in *_hi_prefix): the words in use in
// increasing order, with their number of set bits. mode 0: region cells; mode 1: crossing edges.
void main() {
    const uint hw = gl_GlobalInvocationID.x;
    if (hw >= pc.count) return;
    const bool edges = pc.mode == 1u;
    uint bits = edges ? P.edge_hi.v[hw] : P.cell_hi.v[hw];
    uint out_i = edges ? P.edge_hi_prefix.v[hw] : P.cell_hi_prefix.v[hw];
    while (bits != 0u) {
        const uint b = findLSB(bits);
        bits &= bits - 1u;
        const uint w = 32u * hw + b;
        if (edges) {
            P.edge_word_list.v[out_i] = w;
            P.edge_word_count.v[out_i] = bitCount(P.edge_bits.v[w]);
        } else {
            P.cell_word_list.v[out_i] = w;
            P.cell_word_count.v[out_i] = bitCount(P.cell_bits.v[w]);
        }
        out_i++;
    }
}

#elif STAGE == STAGE_COARSE_VERT
// One invocation per coarse leaf: its vertex, after those of the finest leaves.
void main() {
    const uint k = gl_GlobalInvocationID.x;
    if (k >= pc.count) return;
    const uvec3 xyz = uvec3(P.coarse_records.v[12u * k], P.coarse_records.v[12u * k + 1u], P.coarse_records.v[12u * k + 2u]);
    const uint r = P.nv_fine + uint(coarse_rank(P.coarse_records.v[12u * k + 3u] & 0xffu, xyz));
    F64 rv = F64(uint64_t(P.coarse_records) + 48ul * uint64_t(k) + 16ul);
    for (uint a = 0u; a < 3u; a++) P.V.v[3u * r + a] = rv.v[a];
    P.vtree.v[r] = 1u;
}

#elif STAGE == STAGE_COARSE_FACES
// One invocation per edge of each coarse leaf. An edge that crosses the surface and that no
// smaller leaf touches (every cell around it, at the level of the leaf, is a coarse leaf or lies in
// one) gives a face, made by the first of its four cells that is a coarse leaf of this level: the
// edges of the recursion of Ju et al. in adaptive.h that the finest edges do not cover.
void main() {
    const uint t = gl_GlobalInvocationID.x;
    if (t >= pc.count) return;
    const uint k = t / 12u, e = t % 12u;
    const uvec3 xyz = uvec3(P.coarse_records.v[12u * k], P.coarse_records.v[12u * k + 1u], P.coarse_records.v[12u * k + 2u]);
    const uint level = P.coarse_records.v[12u * k + 3u] & 0xffu, neg = P.coarse_records.v[12u * k + 3u] >> 8;
    const uint o = 6u * (12u * uint(coarse_rank(level, xyz)) + e);
    const int c0 = edge_corners[e][0], c1 = edge_corners[e][1];
    const bool in0 = ((neg >> c0) & 1u) != 0u, in1 = ((neg >> c1) & 1u) != 0u;
    if (in0 == in1) { P.coarse_F.v[o] = NONE; return; }
    ivec3 cs[4];
    cells_around(ivec3(xyz) + ivec3(c0 & 1, (c0 >> 1) & 1, (c0 >> 2) & 1), e / 4u, cs);
    uint v[4];
    int first = -1;
    for (int q = 0; q < 4; q++) {
        uint lvl;
        const int r = coarse_cover(level, cs[q], lvl);
        if (r < 0) { P.coarse_F.v[o] = NONE; return; }  // a smaller leaf touches the edge
        if (lvl == level && first < 0) first = q;
        v[q] = P.nv_fine + uint(r);
    }
    if (cs[first] != ivec3(xyz)) { P.coarse_F.v[o] = NONE; return; }
    emit_face(uint64_t(P.coarse_F), o, v, !in0);
}

#elif STAGE == STAGE_DISSOLVE
// One workgroup per coarse leaf (record k): when the frame dissolves it, its static leaves of the
// finest level, and those within one cell around it, join the region (not the dynamic or swallowed
// ones), so that the frame meshes it by them and remakes the faces around it.
void main() {
    const uint k = gl_WorkGroupID.x;
    if (k >= pc.count) return;
    const uvec3 xyz = uvec3(P.coarse_records.v[12u * k], P.coarse_records.v[12u * k + 1u], P.coarse_records.v[12u * k + 2u]);
    const uint level = P.coarse_records.v[12u * k + 3u] & 0xffu;
    const int r = coarse_rank(level, xyz);
    if (r < 0 || P.dissolved.v[uint(r)] == 0u) return;
    // The box of the leaf and one cell around it, within the grid, by rows along z: with cells in
    // row-major order a row is a run of consecutive bits, taken by words of 32 cells.
    const uint side = 1u << (P.depth - level);
    const ivec3 lo = max(ivec3(xyz * side) - ivec3(1), ivec3(0)), hi = min(ivec3(xyz * side + side + 1u), ivec3(int(P.N)));
    const uint ny = uint(hi.y - lo.y), rows = uint(hi.x - lo.x) * ny, len = uint(hi.z - lo.z);
    for (uint t = gl_LocalInvocationID.x; t < rows; t += gl_WorkGroupSize.x) {
        const uint l0 = lin(uvec3(uint(lo.x) + t / ny, uint(lo.y) + t % ny, uint(lo.z))), l1 = l0 + len - 1u;
        for (uint w = l0 >> 5; w <= (l1 >> 5); w++) {
            uint m = 0xffffffffu;
            if (w == (l0 >> 5)) m &= 0xffffffffu << (l0 & 31u);
            if (w == (l1 >> 5)) m &= 0xffffffffu >> (31u - (l1 & 31u));
            m &= P.static_cell_bits.v[w] & ~P.dyn_bits.v[w] & ~P.touched_bits.v[w];
            if (m != 0u) set_region_bits(w, m);
        }
    }
}
#endif
