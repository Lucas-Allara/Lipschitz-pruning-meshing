    if (P.frame != 0u && !any_changed) { P.F.v[6u * u] = NONE; return; }
    if (any_coarse) { emit_face(uint64_t(P.F), 6u * u, v, P.corner_val.v[key] >= 0.0); return; }
    if (P.corner_val.v[key] >= 0.0) { const uint t = v[1]; v[1] = v[3]; v[3] = t; }
    P.F.v[6u * u] = v[0]; P.F.v[6u * u + 1u] = v[1]; P.F.v[6u * u + 2u] = v[2];
    P.F.v[6u * u + 3u] = v[0]; P.F.v[6u * u + 4u] = v[2]; P.F.v[6u * u + 5u] = v[3];
}
#elif STAGE == STAGE_MC_FACES
ivec3 corner_pos(int c) { return ivec3(c & 1, (c >> 1) & 1, (c >> 2) & 1); }

// The faces of the cell are 2 axis + side; the two faces of edge e are those of its other axes.
int edge_face(int e, int slot) {
    const int a = e / 4, c0 = edge_corners[e][0];
    const int x = slot == 0 ? (a == 0 ? 1 : 0) : (a == 2 ? 1 : 2);
    return 2 * x + ((c0 >> x) & 1);
}

void main() {
    const uint i = gl_GlobalInvocationID.x;
    if (i >= pc.count) return;
    const uint id = P.leaves.v[i];
    // A frame meshes only its new cells, after the kept static triangles in out_F; its new vertices
    // follow the static ones.
    const bool frame = P.frame != 0u;
    if (frame && is_static(id)) return;
    const uint nt = P.ncomp.v[i];
    if (nt == 0u) return;
    const uvec3 xyz = leaf_xyz(id);
    U32 out_f = frame ? P.out_F : P.F;
    const uint vbias = frame ? P.nv_static : 0u;
    bool neg[8];
    for (int c = 0; c < 8; c++) neg[c] = P.corner_val.v[corner_key(xyz + uvec3(corner_pos(c)))] < 0.0;
    bool crossing[12];
    int partner[12][2];
    for (int e = 0; e < 12; e++) {
        crossing[e] = neg[edge_corners[e][0]] != neg[edge_corners[e][1]];
        partner[e][0] = -1;
        partner[e][1] = -1;
    }
    int edge_of[8][8];
    for (int a = 0; a < 8; a++) for (int b = 0; b < 8; b++) edge_of[a][b] = -1;
    for (int e = 0; e < 12; e++) { edge_of[edge_corners[e][0]][edge_corners[e][1]] = e; edge_of[edge_corners[e][1]][edge_corners[e][0]] = e; }
    // The pairings of COMP, face by face (the bits of comp say which way the ambiguous ones went).
    const uint pairing = P.comp.v[2u * i];
    const int ob[4] = {0, 1, 1, 0}, oc[4] = {0, 0, 1, 1};
    for (int axis = 0; axis < 3; axis++) {
        const int bx = (axis + 1) % 3, cx = (axis + 2) % 3;
        for (int side = 0; side < 2; side++) {
            const int fid = 2 * axis + side;
            int corners[4], fe[4], nc = 0;
            for (int q = 0; q < 4; q++) corners[q] = (side << axis) | (ob[q] << bx) | (oc[q] << cx);
            for (int q = 0; q < 4; q++) { fe[q] = edge_of[corners[q]][corners[(q + 1) % 4]]; nc += crossing[fe[q]] ? 1 : 0; }
            int pa[2], pb[2], np = 0;
            if (nc == 2) {
                int first = -1;
                for (int q = 0; q < 4; q++) if (crossing[fe[q]]) { if (first < 0) first = fe[q]; else { pa[0] = first; pb[0] = fe[q]; np = 1; } }
            } else if (nc == 4) {
                np = 2;
                if ((pairing & (1u << fid)) != 0u) { pa[0] = fe[0]; pb[0] = fe[1]; pa[1] = fe[2]; pb[1] = fe[3]; }
                else { pa[0] = fe[3]; pb[0] = fe[0]; pa[1] = fe[1]; pb[1] = fe[2]; }
            }
            for (int k = 0; k < np; k++) {
                partner[pa[k]][edge_face(pa[k], 0) == fid ? 0 : 1] = pb[k];
                partner[pb[k]][edge_face(pb[k], 0) == fid ? 0 : 1] = pa[k];
            }
        }
    }
    // Every cycle as a fan; the vertex of a crossing is its rank. The cycle is walked one way and the
    // fan reversed when its normal (Newell, from the crossing points) points against the direction in
    // which f grows along its edges. The apex of the fan is a crossing whose two faces hold no other
    // segment of the cycle: from a crossing on a face that the cycle crosses twice, a triangle would
    // lie flat in that face, and the neighbor cell would draw it too, reversed.
    bool done[12];
    for (int e = 0; e < 12; e++) done[e] = false;
    const uint base = 3u * (frame ? P.keep_prefix.v[P.n_static_edges] + P.vbase_dyn.v[i] : P.vbase.v[i]);
    uint t = 0u;
    for (int e0 = 0; e0 < 12; e0++) {
        if (!crossing[e0] || done[e0]) continue;
        uint loop[12];
        int seg_face[12];  // the face of the segment from loop[k] to loop[k + 1]
        int n = 0, cur = e0, face = edge_face(e0, 1);
        ivec3 grow = ivec3(0);
        while (cur >= 0 && n < 12) {
            done[cur] = true;
            loop[n] = edge_rank(corner_key(xyz + uvec3(corner_pos(edge_corners[cur][0]))) * 3u + uint(cur / 4));
            grow[cur / 4] += neg[edge_corners[cur][0]] ? 1 : -1;
            const int sl = edge_face(cur, 0) == face ? 1 : 0;
            face = edge_face(cur, sl);
            seg_face[n++] = face;
            cur = partner[cur][sl];
            if (cur == e0) break;
        }
        // Triangle k of the fan from s, (s, s + k, s + k + 1), lies in a face when segment s + k is on
        // one of the two faces of crossing s; for k = 1 and n - 2 it cannot (two edges share one face).
        int apex = 0;
        for (int s = 0; s < n; s++) {
            bool in_face = false;
            for (int k = 2; k <= n - 3; k++) {
                const int sf = seg_face[(s + k) % n];
                if (sf == seg_face[s] || sf == seg_face[(s + n - 1) % n]) in_face = true;
            }
            if (!in_face) { apex = s; break; }
        }
        dvec3 nrm = dvec3(0.0);
        const dvec3 o = dvec3(P.V.v[3u * loop[0]], P.V.v[3u * loop[0] + 1u], P.V.v[3u * loop[0] + 2u]);
        dvec3 prev = dvec3(0.0);
        for (int k = 1; k < n; k++) {
            const dvec3 q = dvec3(P.V.v[3u * loop[k]], P.V.v[3u * loop[k] + 1u], P.V.v[3u * loop[k] + 2u]) - o;
            nrm += cross(prev, q);
            prev = q;
        }
        // On the face of the first segment, the inward normal crossed with the direction in which f
        // grows along the first crossing edge gives the way the cycle runs (marching cubes keeps the
        // inside of the surface on one hand); the Newell normal decides only when that segment has no
        // extent in that direction (a crossing at a corner).
        dvec3 inward = dvec3(0.0), gd = dvec3(0.0);
        inward[seg_face[0] / 2] = (seg_face[0] & 1) != 0 ? -1.0 : 1.0;
        gd[e0 / 4] = neg[edge_corners[e0][0]] ? 1.0 : -1.0;
        const dvec3 p1 = dvec3(P.V.v[3u * loop[1]], P.V.v[3u * loop[1] + 1u], P.V.v[3u * loop[1] + 2u]);
        const double way = dot(p1 - o, cross(inward, gd));
        const bool flip = way != 0.0 ? way < 0.0 : dot(nrm, dvec3(grow)) < 0.0;
        for (int k = 1; k + 1 < n && t < nt; k++) {
            const uint c1 = loop[(apex + k) % n], c2 = loop[(apex + k + 1) % n];
            const uint b1 = flip ? c2 : c1, b2 = flip ? c1 : c2;
            out_f.v[base + 3u * t] = vbias + loop[apex]; out_f.v[base + 3u * t + 1u] = vbias + b1; out_f.v[base + 3u * t + 2u] = vbias + b2;
            t++;
        }
    }
}

