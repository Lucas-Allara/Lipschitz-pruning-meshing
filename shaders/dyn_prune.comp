    const uint cprefix = subgroupExclusiveAdd(want_cell), ctotal = subgroupAdd(want_cell);
    const uint sub_prims = subgroupAdd(prim_evals), sub_ops = subgroupAdd(op_evals), sub_max = subgroupMax(want);
    uint base = 0u, cbase = 0u;
    if (subgroupElect()) {
