        c = make_child(tid);
        if (c.fast && c.in_.n <= P.wide) {
            fstate = fast_state(c);
            if (fstate == 0u) { if (c.static_surface) record_culled(c.cc); }
            else if (fstate != 1u) { keep = true; count = fstate == 2u ? c.in_.n : 1u; }
        } else if (c.in_.n <= P.wide) {
            const double value = local_state(c, false);
            if (!(abs(value) <= P.r_keep)) {
                if (c.static_surface) record_culled(c.cc);
            } else {
                bool sphere;
